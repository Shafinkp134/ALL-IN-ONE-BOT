# Discord
TOKEN=
DISCORD_USER_ID=

# APIs
FACEBOOK_ACCESS_TOKEN=
FORTNITE_API_KEY=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
BOT_API=

# MongoDB
MONGODB_URI=

# MySQL (used by /phpmyadmin and mysql link services)
# For /phpmyadmin command this project enforces local-only hosts:
# MYSQL_HOST must be localhost, 127.0.0.1, or ::1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=10
MYSQL_USERS_TABLE=users
MYSQL_USERS_NAME_COLUMN=name

# Run bot as phpMyAdmin-only utility
PHPMYADMIN_ONLY=true
